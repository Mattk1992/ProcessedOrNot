# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google Analytics (Required for analytics)
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Google AdSense (Required for ads)
VITE_GOOGLE_ADSENSE_CLIENT_ID=your_adsense_client_id_here

# Google AdMob (Required for mobile ads)
VITE_GOOGLE_ADMOB_APP_ID=your_admob_app_id_here

# Database (Automatically configured in Replit)
DATABASE_URL=automatically_configured

# Session Security (Change in production)
SESSION_SECRET=secure-session-key-change-in-production-2024

# Encryption (Optional, will be derived if not provided)
ENCRYPTION_KEY=your_encryption_key_here

# Email Configuration (Optional)
EMAIL_USER=your_email_here
EMAIL_PASS=your_email_password_here

# OpenAI API (Required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Production Settings (Optional)
NODE_ENV=development
ENABLE_TLS=false
ENABLE_HSM=false
ENABLE_POST_QUANTUM=false